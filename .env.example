# Configuration for the dbx-vocareum-* commands in src/dbx_vocareum_tools/.
#
# Copy this file to .env in this directory and fill in real values:
#
#     cp .env.example .env
#
# .env is git-ignored by the repository root .gitignore. Never commit it. Real
# environment variables always take precedence over values in .env, so the same
# script runs unchanged in CI.
#
# Where the values come from:
#   - The course, assignment, and part IDs are shown behind the info icon in the
#     Vocareum UI. Open the assignment, click the info icon, and copy the IDs.
#   - The Vocareum API token is generated in Vocareum account settings under
#     Personal Access Tokens. It requires Organization Admin, is displayed
#     exactly once at creation, and cannot be retrieved again. Its scope also
#     has to cover the course below: a token restricted to a different course
#     answers 403 on every course path and makes GET /courses report an org
#     holding one course. docs/vocareum-api.md has the symptom and the check.
#   - The Databricks values come from the account console at
#     accounts.cloud.databricks.com:
#       - The account ID is in the user menu at the top right.
#       - The service principal is under User management > Service principals.
#         Its client ID is the UUID shown on its Principal information tab.
#       - The OAuth secret is generated on the service principal's Secrets tab.
#         It is shown once.
#       - The workspace URL and numeric workspace ID are on the Workspaces page.
#         Pick the workspace Vocareum created for the part.

# ---------------------------------------------------------------------------
# Vocareum. These four address a part; the fifth addresses one student's
# session within it. Upload needs only the first four, because a workspace
# belongs to the part rather than to a student.
# ---------------------------------------------------------------------------

# Vocareum REST API token. Sent as "Authorization: Token <value>".
VOCAREUM_API_KEY=replace-with-your-vocareum-api-token

# Course ID from the info icon in the Vocareum UI.
VOCAREUM_COURSE_ID=12345

# Assignment ID from the info icon in the Vocareum UI.
VOCAREUM_ASSIGNMENT_ID=67890

# Part ID of the assignment part whose labtype is Databricks, from the same
# info icon. A course's lifecycle scripts are read from this part's
# /voc/scripts directory, and from no other part.
VOCAREUM_PART_ID=1

# Vocareum user ID of the student session being diagnosed. Vocareum publishes
# no endpoint returning the caller's own user ID, so this has to be a real
# enrolled user. Enrol a diagnostic student through POST /courses/{id}/users to
# obtain one.
VOCAREUM_USER_ID=24680

# Optional. Base URL of the Vocareum REST API.
# Defaults to https://api.vocareum.com/api/v2 when unset.
VOCAREUM_API_BASE=https://api.vocareum.com/api/v2

# Optional. The Vocareum-side organization number, which is a different
# identifier from any AWS organization. Without it dbx-vocareum-diagnose skips
# step 4B and every other step still runs, but step 4B is the only place that
# reads error_info, which is where Databricks reports a failure back to
# Vocareum in words. The org path is the only shape that answers for it: the
# course-scoped and part-scoped forms both return 400 Invalid Request.
VOCAREUM_ORG_NUMBER=000

# ---------------------------------------------------------------------------
# Databricks. The service principal is the only credential the tools use.
# It holds Account admin, which is what Vocareum requires of it, so it is far
# more privileged than a student. Every result measured with it describes what
# the service principal may do, not what a student may do. docs/permissions.md
# carries that distinction and why it matters.
# ---------------------------------------------------------------------------

# Workspace URL, with scheme and no trailing slash. This is the host the
# workspace-scoped SDK calls go to, and the value the workspace guard compares
# against, so it has to be the workspace Vocareum is configured to use.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com

# Numeric workspace ID, the o= parameter in a workspace URL. Recorded because
# it is the value that identifies the environment in a Vocareum support thread
# and it cannot be derived from the host.
DATABRICKS_WORKSPACE_ID=0000000000000000

# Databricks E2 account ID. A UUID. Also the STS external ID on the
# vocareum-db trust policy.
DATABRICKS_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# Service principal OAuth credentials. The client ID is the application ID,
# labelled UUID on the Principal information tab in the console. The secret is
# displayed once at generation and cannot be recovered; regenerating it changes
# only its expiration date, not the client ID.
DATABRICKS_CLIENT_ID=00000000-0000-0000-0000-000000000000
DATABRICKS_CLIENT_SECRET=replace-with-the-oauth-secret

# Optional. Account console host for account-scoped calls, which is a different
# host from the workspace above. Defaults to https://accounts.cloud.databricks.com.
DATABRICKS_ACCOUNT_HOST=https://accounts.cloud.databricks.com

# Optional. A personal access token belonging to the lab user, generated from
# inside a live student session. Vocareum's session record for a Databricks part
# publishes no Databricks credential, so this is the only way to measure what a
# student may actually do. Read by `dbx-vocareum-probe --source token`, and by
# nothing else. It expires with the session that made it, so it is a
# measurement credential rather than a stored one.
DATABRICKS_LAB_USER_TOKEN=

# ---------------------------------------------------------------------------
# Environment identifiers, recorded for reference.
#
# Nothing below is read at run time. These are kept in .env so the IDs live in
# one git-ignored place instead of being scattered through documents that get
# committed. The documents under docs/ refer to them as ${NAME}.
# ---------------------------------------------------------------------------

# The AWS account holding the Databricks workspace root bucket and the
# vocareumvm, vocareum-db, and vocareum-db-uc roles. One account for the whole
# course, unlike an AWS Cloud Lab, where each student gets their own.
DBX_AWS_ACCOUNT_ID=000000000000
DBX_AWS_REGION=us-west-2

# Vocareum's own AWS account, the principal in the vocareumvm trust policy.
VOCAREUM_AWS_ACCOUNT_ID=000000000000

# The AWS account that owns the S3 bucket, IAM role and policies behind a
# course's Unity Catalog external location. This is not the Databricks account
# ID, which is a UUID and is set above as DATABRICKS_ACCOUNT_ID. The two are
# routinely confused, and a UC external location that will not validate is
# usually the wrong one of the pair.
AWS_ACCOUNT_ID=000000000000

# Login of the enrolled student used for diagnostics, and the email Vocareum
# assigns that student inside the Databricks workspace. The two differ:
# VOC_DB_USER_EMAIL is Vocareum's generated lab identity, and it is the name
# the lifecycle scripts see.
VOCAREUM_USER_EMAIL=you+student1@example.com
DATABRICKS_LAB_USER_EMAIL=replace-with-the-VOC_DB_USER_EMAIL-value
